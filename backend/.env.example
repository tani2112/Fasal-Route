# FasalRoute Environment Configuration
# Team: ex-ONYX | AI for Indian Smallholders

# Sarvam AI API Credentials
# Get your key at https://dashboard.sarvam.ai
SARVAM_API_KEY=your_sarvam_api_key_here

# Open Government Data (data.gov.in) / Agmarknet API Key
# Optional: falls back to seeded high-resolution mandi dataset when omitted
DATA_GOV_API_KEY=your_data_gov_in_api_key_here

# Simulation Flag
# Set to 'false' to connect directly to Sarvam AI cloud endpoints (Saaras v4, Sarvam-105B, Bulbul)
# Set to 'true' for local zero-credit hackathon demo
USE_MOCKS=true

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true
DATABASE_URL=sqlite+aiosqlite:///./fasalroute.db
